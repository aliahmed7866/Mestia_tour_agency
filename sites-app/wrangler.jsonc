{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "svaneti-guide",
  "main": "./build/cloudflare-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "svaneti-guide",
      "database_id": "8d399f1a-95ee-430e-a614-b38ccf2ad9e7"
    }
  ],
  "vars": {
    "DEPLOY_TARGET": "cloudflare"
  },
  "keep_vars": true
}
