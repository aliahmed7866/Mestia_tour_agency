# setup-termux.sh generates a random key without replacing an existing .env.
# Keep this private. Never commit the real .env or copy its key into this file.
SECRET_KEY=GENERATE_WITH_SETUP_SCRIPT

# Relative database paths are resolved from this project directory.
MESTIA_DB=instance/mestia.sqlite3
MESTIA_MEDIA_DIR=instance/uploads
MESTIA_HOST=127.0.0.1
PORT=8095

# Password-only staff login for now. Set to 1 to require authenticator codes.
# Enroll staff via reset-user with this flag enabled before restarting the server.
MESTIA_REQUIRE_TOTP=0

# Local HTTP only by default. Set cookies to 1 before serving public HTTPS.
MESTIA_SECURE_COOKIES=0
# Set to 1 only for ONE trusted proxy; keep the origin bound to loopback.
MESTIA_TRUST_PROXY=0

# Public HTTPS origin; leave empty for local Termux use. No trailing path.
MESTIA_PUBLIC_URL=
# Enable only after reviewing the public pages and launch policies.
MESTIA_INDEXING_ENABLED=0
# PythonAnywhere uses DELETE; local persistent disks and Termux use WAL.
MESTIA_SQLITE_JOURNAL_MODE=WAL
